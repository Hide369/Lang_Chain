[Unit]
Description=Go詳細設計書の夜間生成
# 推論サーバー（vLLM / Ollama）には依存させない。ollama.service を Wants にすると、
# Conflicts=ollama.service を持つ vllm.service と衝突して起動・再起動が失敗する（または vLLM が止まる）。
# 推論サーバーが動いているかは、各実行の開始時に preflight が確認する
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# 設置時に実行ユーザーへ置き換える（README「定期実行」参照）。Goリポジトリの git pull ができるユーザーにすること
User=REPLACE_WITH_USER
# 設定（対象リポジトリ GODOC_REPO・出力先 GODOC_OUT を含む）はすべて /opt/Lang_Chain/.env に書く。
# ここに Environment= を書かないこと（設定の置き場所が2か所になり、.env を直しても反映されなくなる）
ExecStart=/opt/Lang_Chain/deploy/nightly.sh
# 全件の生成は長時間かかるが、ハングしたまま翌日の実行を妨げないよう上限を設ける
TimeoutStartSec=12h
