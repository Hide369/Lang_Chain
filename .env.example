# .env にコピーして使う（.env はコミットしない）
# 設定はすべてこの .env にまとめる（runner・Web 画面・夜間バッチ deploy/nightly.sh が読む。systemd のユニットには書かない）

# 設計書スキルの SKILL.md のパス（任意）。すべての言語で共通のスキルを使う。
# 省略時は <このフォルダ>/skills/design-doc-batch/SKILL.md。別の場所に置く場合だけ指定する
# CLAUDE_SKILL_PATH=/opt/Batch_Exec/skills/design-doc-batch/SKILL.md
# ソースファイルにコメントを追記するスキルの SKILL.md のパス（任意）。設定すると設計書と一緒にコメント追記も実行する
# 省略時は <このフォルダ>/skills/comment-batch/SKILL.md があればそれを使う（Web 画面から登録するとここに置かれる）
# CLAUDE_COMMENT_SKILL_PATH=/opt/Batch_Exec/skills/go-comment/SKILL.md
# claude コマンド（tmux / nohup から起動すると PATH に ~/.local/bin が入らないことがあるため、`which claude` のフルパス推奨）
CLAUDE_BIN=claude
# 1ファイルあたりのエージェントのターン数上限。1000000 は事実上の無制限
# （コンテキストを超えたファイルは警告付きでスキップされるため、ターン数では打ち切らない）
CLAUDE_MAX_TURNS=1000000
# 1回の claude 実行のタイムアウト（秒）。1000000（約11.5日）は事実上の無制限
# （応答しなくなった実行も止まらず、その間はセッション枠を1つふさぐ。止めるときは画面の「停止」を使う）
CLAUDE_TIMEOUT_S=1000000

# 推論サーバー（vLLM）の接続先。Claude Code はこの URL の /v1/messages（Anthropic 互換API）を呼ぶ
# Ollama から移行したサーバーでは、vLLM を Ollama と同じ 11434 番ポートで待ち受けている（vllm serve ... --port 11434）
# 同じサーバー内で動かす場合は 127.0.0.1 のままにして外部公開しない
LLM_BASE_URL=http://127.0.0.1:11434
# vLLM の --served-model-name（別名）と完全一致させる。Qwen3-Coder-Next に claude-opus-4-6 という別名を付けて提供している
# （ヘッドレスの Claude Code は Claude のモデル名しか受け付けない）
LLM_MODEL=claude-opus-4-6
# vLLM の --max-model-len と必ず同じ値にする（大きすぎるファイルを事前に弾く基準・入力トークン数の警告の基準に使う）
# 入力がこれを超えたファイルは、vLLM に断られても失敗にせず、警告付きでスキップして次のファイルへ進む
LLM_NUM_CTX=262144
# 1回の claude 実行の入力トークン数が LLM_NUM_CTX のこの割合を超えたら計測ログに警告を残す（0より大きく1以下。合否は変えない）
LLM_CTX_WARN_RATIO=0.9
# Claude Code の1回の応答の最大出力トークン数（コメント追記はファイル全文を出力するため、対象ファイルの大きさの上限にもなる）
LLM_NUM_PREDICT=8192
# 同時に動かす Claude Code のセッション数は .env では設定しない。1回の実行あたり既定 10（Web 画面・--concurrency で 1〜10 を指定できる）、
# さらにサーバー全体（複数人の実行・夜間バッチの合計）でも 10 までに抑える

# 処理対象の言語・フォルダ・ファイル・除外の設定ファイル（任意。書き方は docs/target_files.md）
# 省略時は <このフォルダ>/targets.toml、それもなければ targets.example.toml を使う
# TARGETS_CONFIG=/opt/Batch_Exec/targets.toml

# 検証NG時の生成回数の上限（初回を含む）
DOC_MAX_ATTEMPTS=3

# ---- 夜間バッチ（deploy/nightly.sh・godoc-nightly.timer。Web 画面の定期実行を使う場合は不要） ----
# 対象リポジトリ（必須）
# GODOC_REPO=/srv/repos/myapp
# 出力先（任意。既定 <このフォルダ>/out）
# GODOC_OUT=/opt/Batch_Exec/out

# LangSmith トレース。有効にするとスキル・プロンプト・設計書が外部(LangSmithクラウド)に送信される。
# 社外秘コードの場合は false のままにすること。
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=design-doc-batch

# ---- Web 画面（python -m godoc_agent.web。詳しくは docs/web_ui.md） ----
# この .env を変えたら `sudo systemctl reload godoc-web`（次の実行から反映）。WEB_* を変えたときだけ restart する
# 管理者パスワードのハッシュ（必須）。`.venv/bin/python -m godoc_agent.web.password` で作った行をそのまま貼る
# WEB_ADMIN_PASSWORD_HASH=scrypt:32768:8:1:...
# フォルダ選択ダイアログで辿れる起点（必須。カンマ区切りの絶対パス）。対象・出力先はこの下からしか選べない
# WEB_BROWSE_ROOTS=/srv/repos,/opt/Batch_Exec/out
# 待ち受けるアドレスとポート。LAN の他の PC から使うなら 0.0.0.0（既定 127.0.0.1 は GB10 自身からだけ）
WEB_HOST=0.0.0.0
WEB_PORT=4000
# ログインの有効時間（時間）
WEB_SESSION_TTL_HOURS=12
# true にすると、閲覧（状態・ログ・生成物）にもログインが必要になる（既定は閲覧は誰でも、実行・設定変更は管理者だけ）
WEB_VIEW_REQUIRES_LOGIN=false
# HTTPS（リバースプロキシ経由など）で使う場合は true（ログインの Cookie を HTTPS でしか送らなくする）
WEB_COOKIE_SECURE=false
# 画面で選んだフォルダ（ブラウザごと）・定期実行の設定の保存先（任意。既定 <このフォルダ>/state/web）
# WEB_STATE_DIR=/opt/Batch_Exec/state/web
