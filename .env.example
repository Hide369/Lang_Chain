# .env にコピーして使う（.env はコミットしない）

# Ollama（同じサーバー内で動かす場合は 127.0.0.1 のままにして外部公開しない）
OLLAMA_BASE_URL=http://127.0.0.1:11434
# `ollama list` に表示されるタグ名と完全一致させる
LLM_MODEL=qwen3-coder-next
# サーバー側の OLLAMA_CONTEXT_LENGTH と揃える
LLM_NUM_CTX=65536
LLM_NUM_PREDICT=8192
LLM_TIMEOUT_S=600
# サーバー側の OLLAMA_NUM_PARALLEL と揃える
LLM_CONCURRENCY=2

# 検証NG時の生成回数の上限（初回を含む）
DOC_MAX_ATTEMPTS=3
# 既存スキル(SKILL.md)のテンプレートに差し替える場合に指定
# DOC_TEMPLATE_PATH=/opt/Lang_Chain/prompts/design_doc_template.md
# CHECKPOINT_DB=/opt/Lang_Chain/state/checkpoints.sqlite

# --engine claude-code 用（Ollama の設定は上の値を共用する）
# 既存スキルの SKILL.md のパス（claude-code エンジンでは必須）
# CLAUDE_SKILL_PATH=/opt/Lang_Chain/skills/go-design-doc/SKILL.md
# claude コマンド（PATH にない場合はフルパス）
CLAUDE_BIN=claude
# 1ファイルあたりのエージェントのターン数上限（暴走・コンテキスト超過の抑止）
CLAUDE_MAX_TURNS=30
# 1回の claude 実行のタイムアウト（秒）
CLAUDE_TIMEOUT_S=1800

# LangSmith トレース。有効にするとソースコードが外部(LangSmithクラウド)に送信される。
# 社外秘コードの場合は false のままにすること。
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=go-design-doc
